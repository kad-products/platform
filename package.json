{
	"name": "@kad-products/platform",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write .",
		"ci:lint": "pnpm biome:check && pnpm knip:check && pnpm prettier:check",
		"knip:check": "knip",
		"knip:fix": "knip --fix",
		"prepare": "husky",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"staged:lint": "lint-staged --allow-empty"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		],
		"package.json": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"husky": "^9.1.7",
		"knip": "^6.37.0",
		"lint-staged": "^17.0.0",
		"prettier": "^3.8.2",
		"prettier-plugin-packagejson": "^3.0.2"
	},
	"packageManager": "pnpm@12.4.2"
}
