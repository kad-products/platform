{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"customManagers": [
		{
			"description": "Keep biome.json $schema version in sync with @biomejs/biome package version.",
			"customType": "regex",
			"fileMatch": ["^biome\\.json$"],
			"matchStrings": ["\"\\$schema\":\\s*\"https://biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json\""],
			"depNameTemplate": "@biomejs/biome",
			"datasourceTemplate": "npm"
		}
	],
	"minimumReleaseAge": "3 days",
	"packageRules": [
		// NODE
		{
			"description": "Automerge Node.js non-major updates",
			"matchPackageNames": ["node"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"platformAutomerge": true
		},
		// GITHUB ACTIONS
		{
			"description": "Automerge GitHub Actions non-major updates",
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"platformAutomerge": true
		},
		// BIOME
		{
			"groupName": "Biome",
			"description": "Group biome config and package major updates together, no automerge",
			"matchPackageNames": ["@biomejs/biome"],
			"matchUpdateTypes": ["major"],
			"automerge": false
		},
		{
			"groupName": "Biome",
			"description": "Group biome config and package non-major together and auto-merge",
			"matchPackageNames": ["@biomejs/biome"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"platformAutomerge": true
		},
		// PLAYWRIGHT
		{
			"description": "Group Playwright major updates together. No automerge — major versions often require test updates.",
			"matchPackageNames": ["@playwright/test", "@playwright/experimental-ct-react", "mcr.microsoft.com/playwright"],
			"matchUpdateTypes": ["major"],
			"groupName": "Playwright",
			"automerge": false
		},
		{
			"description": "Group Playwright npm packages and Docker image together and automerge. The container image in playwright-ct.yaml and npm packages are updated in the same PR, so a passing CI check confirms they're in sync.",
			"matchPackageNames": ["@playwright/test", "@playwright/experimental-ct-react", "mcr.microsoft.com/playwright"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "Playwright",
			"automerge": true,
			"platformAutomerge": true
		},
		// OTHER KEY NPM PACKAGE GROUPS
		{
			"description": "Group Drizzle packages together. No automerge — migrations may be needed.",
			"matchPackageNames": ["drizzle-orm", "drizzle-kit", "drizzle-zod", "drizzle-seed", "drizzle-mermaid-generator"],
			"groupName": "Drizzle",
			"automerge": false
		},
		{
			"description": "Group Cloudflare packages together. No automerge — wrangler and worker types often have behaviour changes.",
			"matchPackageNames": ["wrangler", "@cloudflare/workers-types", "@cloudflare/vite-plugin"],
			"groupName": "Cloudflare",
			"automerge": false
		},
		{
			"description": "Group RedwoodSDK packages together.",
			"matchPackageNames": ["rwsdk"],
			"groupName": "RedwoodSDK",
			"automerge": false
		},
		// MISC
		{
			"groupName": "dependency (non-major)",
			"description": "Group and automerge non-major dependency updates",
			"matchDepTypes": ["devDependencies", "dependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"platformAutomerge": true
		}
	]
}
